//! $RTH={"type":"gui"}

const { app, BrowserWindow } = WApplication;

let mainWindow;

process.title = 'Microhard Edge BETA';

app.on('ready', () => {
    mainWindow = new BrowserWindow();
    mainWindow.load('../Microhard.Winbows.Edge/window.js');

    mainWindow.on('closed', () => {
        mainWindow = null;
    });
})

try {
    await app.executeAsync();
} catch (err) {
    console.error('App crashed:', err);
}